# Composer installs nepdatejs/nepdate from a git archive of this repository.
# Only the PHP package goes into it: composer.json, php/src, php/data,
# php/README.md, LICENSE and README.md. Everything below is left out.
/.changeset              export-ignore
/.editorconfig           export-ignore
/.github                 export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.prettierignore         export-ignore
/.prettierrc.json        export-ignore
/CODE_OF_CONDUCT.md      export-ignore
/CONTRIBUTING.md         export-ignore
/RELEASING.md            export-ignore
/SECURITY.md             export-ignore
/apps                    export-ignore
/boundaries.json         export-ignore
/data                    export-ignore
/eslint.config.js        export-ignore
/package.json            export-ignore
/packages                export-ignore
/pnpm-lock.yaml          export-ignore
/pnpm-workspace.yaml     export-ignore
/scripts                 export-ignore
/tsconfig.base.json      export-ignore
/tsconfig.json           export-ignore
/tsconfig.typetests.json export-ignore
/vitest.config.ts        export-ignore
/php/tests               export-ignore
/php/phpunit.xml         export-ignore
/php/phpstan.neon        export-ignore
/php/pint.json           export-ignore
