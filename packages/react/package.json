{
  "name": "@nepdate/react",
  "version": "0.0.0",
  "description": "Nepali BS/AD date picker and calendar for React: headless hooks and styled components.",
  "keywords": [
    "nepali",
    "bikram-sambat",
    "bs",
    "nepali-date",
    "date",
    "calendar",
    "datepicker",
    "nepal"
  ],
  "license": "MIT",
  "author": "Shishir Rai",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@nepdate/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./headless": {
      "@nepdate/source": "./src/headless.ts",
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./server": {
      "@nepdate/source": "./src/server.ts",
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack"
  },
  "dependencies": {
    "@nepdate/calendar": "workspace:^",
    "@nepdate/core": "workspace:^",
    "@nepdate/datepicker": "workspace:^",
    "@nepdate/dom": "workspace:^",
    "@nepdate/styles": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "typesVersions": {
    "*": {
      "headless": [
        "./dist/headless.d.cts"
      ],
      "server": [
        "./dist/server.d.cts"
      ]
    }
  }
}
