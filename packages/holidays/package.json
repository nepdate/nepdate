{
  "name": "@nepdate/holidays",
  "version": "0.0.0",
  "description": "Nepal's fixed-date national days, plus a loader for each year's official holiday list. Works with @nepdate/calendar.",
  "keywords": [
    "nepali",
    "bikram-sambat",
    "nepal",
    "holidays",
    "public-holidays",
    "calendar"
  ],
  "license": "MIT",
  "author": "Shishir Rai",
  "homepage": "https://github.com/nepdate/nepdate/tree/main/packages/holidays#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nepdate/nepdate.git",
    "directory": "packages/holidays"
  },
  "bugs": {
    "url": "https://github.com/nepdate/nepdate/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@nepdate/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack"
  },
  "dependencies": {
    "@nepdate/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
