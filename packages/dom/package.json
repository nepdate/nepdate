{
  "name": "@nepdate/dom",
  "version": "0.0.0",
  "description": "Tiny browser helpers for @nepdate adapters: popover placement, outside click, Escape, focus.",
  "keywords": [
    "nepali",
    "bikram-sambat",
    "bs",
    "nepali-date",
    "date",
    "calendar",
    "datepicker",
    "nepal"
  ],
  "license": "MIT",
  "author": "Shishir Rai",
  "homepage": "https://github.com/nepdate/nepdate/tree/main/packages/dom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nepdate/nepdate.git",
    "directory": "packages/dom"
  },
  "bugs": {
    "url": "https://github.com/nepdate/nepdate/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@nepdate/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack"
  },
  "publishConfig": {
    "access": "public"
  }
}
