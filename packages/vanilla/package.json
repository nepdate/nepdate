{
  "name": "@nepdate/vanilla",
  "version": "0.0.0",
  "description": "Nepali BS/AD date picker and calendar as Web Components and a plain JavaScript API.",
  "keywords": [
    "nepali",
    "bikram-sambat",
    "bs",
    "nepali-date",
    "date",
    "calendar",
    "datepicker",
    "nepal"
  ],
  "license": "MIT",
  "author": "Shishir Rai",
  "homepage": "https://github.com/nepdate/nepdate/tree/main/packages/vanilla#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nepdate/nepdate.git",
    "directory": "packages/vanilla"
  },
  "bugs": {
    "url": "https://github.com/nepdate/nepdate/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/auto-define.*",
    "./dist/*.global.js",
    "./src/auto-define.ts",
    "./src/global.ts"
  ],
  "exports": {
    ".": {
      "@nepdate/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./define": {
      "@nepdate/source": "./src/auto-define.ts",
      "import": {
        "types": "./dist/auto-define.d.ts",
        "default": "./dist/auto-define.js"
      },
      "require": {
        "types": "./dist/auto-define.d.cts",
        "default": "./dist/auto-define.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/nepdate-picker.global.js",
  "jsdelivr": "./dist/nepdate-picker.global.js",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack"
  },
  "dependencies": {
    "@nepdate/core": "workspace:^",
    "@nepdate/calendar": "workspace:^",
    "@nepdate/datepicker": "workspace:^",
    "@nepdate/dom": "workspace:^",
    "@nepdate/styles": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "define": [
        "./dist/auto-define.d.cts"
      ]
    }
  }
}
